version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: monthly
    open-pull-requests-limit: 5
    labels:
      - dependencies
      - ci
    # mod-base is pinned by SHA and bumped only with `scripts/ci/mod_base_kit.py bump --to vX.Y.Z`,
    # which also re-synchronizes the managed files. A Dependabot bump would fail `template check`.
    # The managed region of pages.yml also pins actions/deploy-pages, so it moves only with a kit
    # bump as well. So does actions/create-github-app-token, which the managed
    # mod-base-gate-status.yml pins once the shared Build and packaged E2E gates are active.
    ignore:
      - dependency-name: "The-Plum-Team/mod-base*"
      - dependency-name: "actions/deploy-pages"
      - dependency-name: "actions/create-github-app-token"
    groups:
      github-actions:
        patterns:
          - "*"
